{
  "$schema": "./@types/schema/package/index.json",
  "package_version": 2,
  "name": "cocos-mcp-server",
  "version": "1.5.0",
  "description": "i18n:cocos-mcp-server.description",
  "author": "LiDaxian & wiidede",
  "editor": ">=3.8.6",
  "main": "./dist/main.cjs",
  "files": [
    "dist/",
    "i18n/",
    "package.json",
    "static/"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown -w",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fs-extra": "^11.3.6",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@cocos/creator-types": "^3.8.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "panels": {
    "default": {
      "title": "i18n:cocos-mcp-server.panel_title",
      "type": "dockable",
      "main": "dist/panels/default/index.cjs",
      "icon": "./static/icon.png",
      "size": {
        "min-width": 400,
        "min-height": 300,
        "width": 600,
        "height": 500
      }
    },
    "dev-test": {
      "title": "Dev Test",
      "type": "dockable",
      "main": "dist/panels/dev-test/index.cjs",
      "icon": "./static/icon.png",
      "size": {
        "min-width": 600,
        "min-height": 400,
        "width": 900,
        "height": 700
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.extension/Cocos MCP Server",
        "label": "i18n:cocos-mcp-server.open_panel",
        "message": "open-panel"
      },
      {
        "path": "i18n:menu.extension/Cocos MCP Server",
        "label": "Dev Test Panel",
        "message": "open-dev-test-panel"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "open-dev-test-panel": {
        "methods": [
          "openDevTestPanel"
        ]
      },
      "callTool": {
        "methods": [
          "callTool"
        ]
      },
      "open-tool-manager": {
        "methods": [
          "openToolManager"
        ]
      },
      "start-server": {
        "methods": [
          "startServer"
        ]
      },
      "stop-server": {
        "methods": [
          "stopServer"
        ]
      },
      "get-server-status": {
        "methods": [
          "getServerStatus"
        ]
      },
      "update-settings": {
        "methods": [
          "updateSettings"
        ]
      },
      "getToolsList": {
        "methods": [
          "getToolsList"
        ]
      },
      "get-server-settings": {
        "methods": [
          "getServerSettings"
        ]
      },
      "getToolManagerState": {
        "methods": [
          "getToolManagerState"
        ]
      },
      "createToolConfiguration": {
        "methods": [
          "createToolConfiguration"
        ]
      },
      "updateToolConfiguration": {
        "methods": [
          "updateToolConfiguration"
        ]
      },
      "deleteToolConfiguration": {
        "methods": [
          "deleteToolConfiguration"
        ]
      },
      "setCurrentToolConfiguration": {
        "methods": [
          "setCurrentToolConfiguration"
        ]
      },
      "updateToolStatus": {
        "methods": [
          "updateToolStatus"
        ]
      },
      "updateToolStatusBatch": {
        "methods": [
          "updateToolStatusBatch"
        ]
      },
      "exportToolConfiguration": {
        "methods": [
          "exportToolConfiguration"
        ]
      },
      "importToolConfiguration": {
        "methods": [
          "importToolConfiguration"
        ]
      },
      "getEnabledTools": {
        "methods": [
          "getEnabledTools"
        ]
      }
    },
    "scene": {
      "script": "./dist/scene.cjs",
      "methods": [
        "createNewScene",
        "addComponentToNode",
        "removeComponentFromNode",
        "getNodeInfo",
        "getAllNodes",
        "findNodeByName",
        "setNodeProperty",
        "setComponentProperty",
        "getCurrentSceneInfo",
        "getSceneHierarchy",
        "createPrefabFromNode"
      ]
    }
  }
}
